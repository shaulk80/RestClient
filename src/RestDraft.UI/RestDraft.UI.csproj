<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>RestDraft</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- The LibraryImport source generator emits unsafe code for NativeMessageBox. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.AvaloniaEdit" />
    <PackageReference Include="AvaloniaEdit.TextMate" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\RestDraft.Infrastructure\Persistence\MigrationScripts\0001\0001_create_settings.sql"
          Link="MigrationScripts\0001\0001_create_settings.sql"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\RestDraft.Infrastructure\Persistence\MigrationScripts\0002\0002_create_collections.sql"
          Link="MigrationScripts\0002\0002_create_collections.sql"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\RestDraft.Infrastructure\Persistence\MigrationScripts\0003\0003_create_history.sql"
          Link="MigrationScripts\0003\0003_create_history.sql"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\RestDraft.Infrastructure\Persistence\MigrationScripts\0004\0004_create_environments.sql"
          Link="MigrationScripts\0004\0004_create_environments.sql"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\RestDraft.Infrastructure\Persistence\MigrationScripts\0005\0005_create_open_tabs.sql"
          Link="MigrationScripts\0005\0005_create_open_tabs.sql"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\RestDraft.Infrastructure\Persistence\MigrationScripts\0006\0006_history_url_as_typed.sql"
          Link="MigrationScripts\0006\0006_history_url_as_typed.sql"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RestDraft.Application\RestDraft.Application.csproj" />
    <ProjectReference Include="..\RestDraft.Infrastructure\RestDraft.Infrastructure.csproj" />
  </ItemGroup>

</Project>
