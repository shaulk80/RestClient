<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RestDraft.UI.ViewModels"
             xmlns:views="using:RestDraft.UI.Views"
             x:Class="RestDraft.UI.Views.KeyValueEditorView"
             x:DataType="vm:KeyValueEditorViewModel">
  <StackPanel Spacing="6">
    <ItemsControl ItemsSource="{Binding Rows}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:KeyValueRowViewModel">
          <Grid ColumnDefinitions="Auto,*,*,Auto" ColumnSpacing="6" Margin="0,2">
            <CheckBox Grid.Column="0"
                      IsChecked="{Binding IsEnabled}"
                      AutomationProperties.Name="{Binding EnabledAutomationName}" />
            <TextBox Grid.Column="1"
                     Text="{Binding Key}"
                     PlaceholderText="Name"
                     AutomationProperties.Name="{Binding NameAutomationName}" />
            <TextBox Grid.Column="2"
                     Text="{Binding Value}"
                     PlaceholderText="Value"
                     AutomationProperties.Name="{Binding ValueAutomationName}" />
            <Button Grid.Column="3"
                    Content="Remove"
                    Command="{Binding RemoveCommand}"
                    AutomationProperties.Name="{Binding RemoveAutomationName}" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <Button HorizontalAlignment="Left"
            Content="{Binding AddRowText}"
            Command="{Binding AddRowCommand}"
            IsVisible="{Binding ShowAddButton, RelativeSource={RelativeSource AncestorType=views:KeyValueEditorView}}" />
  </StackPanel>
</UserControl>
