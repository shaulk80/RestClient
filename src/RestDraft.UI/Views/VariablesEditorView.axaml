<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RestDraft.UI.ViewModels"
             x:Class="RestDraft.UI.Views.VariablesEditorView"
             x:DataType="vm:VariablesEditorViewModel">
  <DockPanel LastChildFill="True">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
      <Button Content="Add variable" Command="{Binding AddCommand}" />
      <Button Content="Save" Command="{Binding SaveCommand}" />
      <TextBlock VerticalAlignment="Center"
                 Text="{Binding Message}"
                 AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
    <ScrollViewer>
      <ItemsControl ItemsSource="{Binding Rows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:VariableRowViewModel">
            <Grid ColumnDefinitions="*,2*,Auto,Auto" ColumnSpacing="6" Margin="0,0,0,6">
              <TextBox Grid.Column="0"
                       PlaceholderText="Name"
                       Text="{Binding Name}"
                       AutomationProperties.Name="Variable name" />
              <TextBox Grid.Column="1"
                       PlaceholderText="{Binding ValueHint}"
                       PasswordChar="{Binding PasswordChar}"
                       Text="{Binding Value}"
                       AutomationProperties.Name="Variable value" />
              <CheckBox Grid.Column="2" Content="Secret" IsChecked="{Binding IsSecret, Mode=TwoWay}" />
              <Button Grid.Column="3"
                      Content="Remove"
                      Command="{Binding RemoveCommand}"
                      AutomationProperties.Name="Remove variable" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>
