<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RestClient.UI.ViewModels"
             x:Class="RestClient.UI.Views.AuthEditorView"
             x:DataType="vm:AuthEditorViewModel">
  <StackPanel Spacing="6">
    <ComboBox MinWidth="160"
              ItemsSource="{Binding Types}"
              SelectedItem="{Binding Type}"
              AutomationProperties.Name="Authorization type" />
    <StackPanel IsVisible="{Binding IsBasic}" Spacing="6">
      <TextBox PlaceholderText="Username" Text="{Binding Username}" AutomationProperties.Name="Username" />
      <TextBox PlaceholderText="Password"
               PasswordChar="*"
               Text="{Binding Password}"
               AutomationProperties.Name="Password" />
    </StackPanel>
    <TextBox IsVisible="{Binding IsBearer}"
             PlaceholderText="Token"
             PasswordChar="*"
             Text="{Binding Token}"
             AutomationProperties.Name="Bearer token" />
    <StackPanel IsVisible="{Binding IsApiKey}" Spacing="6">
      <TextBox PlaceholderText="Key name" Text="{Binding ApiKeyName}" AutomationProperties.Name="API key name" />
      <TextBox PlaceholderText="Value"
               PasswordChar="*"
               Text="{Binding ApiKeyValue}"
               AutomationProperties.Name="API key value" />
      <ComboBox MinWidth="160"
                ItemsSource="{Binding Locations}"
                SelectedItem="{Binding ApiKeyLocation}"
                AutomationProperties.Name="Send API key in" />
    </StackPanel>
  </StackPanel>
</UserControl>
