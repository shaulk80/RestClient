<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RestClient.UI.ViewModels"
             xmlns:views="using:RestClient.UI.Views"
             x:Class="RestClient.UI.Views.RequestBuilderView"
             x:DataType="vm:RequestTabViewModel">
  <StackPanel Margin="12" Spacing="8">
    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
      <ComboBox Grid.Column="0"
                MinWidth="110"
                ItemsSource="{Binding Methods}"
                SelectedItem="{Binding Method}" />
      <TextBox Grid.Column="1"
               Text="{Binding Url}"
               PlaceholderText="https://example.com/resource" />
      <Button Grid.Column="2"
              Content="Send"
              Command="{Binding SendCommand}" />
      <Button Grid.Column="3"
              Content="Cancel"
              Command="{Binding CancelCommand}" />
      <Button Grid.Column="4"
              Content="Save"
              Command="{Binding SaveCommand}" />
    </Grid>
    <TextBlock Text="{Binding SaveError}"
               Foreground="Red"
               TextWrapping="Wrap" />
    <views:BodyEditorView DataContext="{Binding BodyEditor}" />
    <views:AuthEditorView DataContext="{Binding AuthEditor}" />
  </StackPanel>
</UserControl>
