<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RestClient.UI.ViewModels"
             xmlns:domain="using:RestClient.Domain.Collections"
             xmlns:controls="using:RestClient.UI.Controls"
             x:Class="RestClient.UI.Views.ResponseView"
             x:DataType="vm:RequestTabViewModel">
  <Grid Margin="12" RowDefinitions="Auto,Auto,*" RowSpacing="8">
    <StackPanel Grid.Row="0" Spacing="4">
      <TextBlock Text="{Binding Response.ErrorMessage}"
                 Classes="error"
                 TextWrapping="Wrap"
                 AutomationProperties.LiveSetting="Polite" />
      <TextBlock Text="{Binding Response.StatusText}"
                 FontWeight="SemiBold"
                 AutomationProperties.LiveSetting="Polite" />
      <TextBlock Text="{Binding Response.TimingText}" />
      <TextBlock Text="{Binding Response.SizeText}" />
      <TextBlock Text="{Binding Response.BodyNote}" FontStyle="Italic" />
      <StackPanel Orientation="Horizontal" Spacing="12">
        <RadioButton Content="Pretty"
                     GroupName="ResponseBodyView"
                     IsChecked="{Binding Response.IsPrettyView}"
                     IsEnabled="{Binding Response.CanPrettyPrint}" />
        <RadioButton Content="Raw"
                     GroupName="ResponseBodyView"
                     IsChecked="{Binding Response.IsRawView}" />
      </StackPanel>
    </StackPanel>
    <ItemsControl Grid.Row="1"
                  ItemsSource="{Binding Response.Headers}"
                  AutomationProperties.Name="Response headers">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="domain:KeyValueEntry">
          <TextBlock TextWrapping="Wrap">
            <Run FontWeight="SemiBold" Text="{Binding Key}" />
            <Run Text=": " />
            <Run Text="{Binding Value}" />
          </TextBlock>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <controls:CodeEditor Grid.Row="2"
                         EditorText="{Binding Response.BodyText}"
                         Language="{Binding Response.Language}"
                         IsReadOnly="True"
                         WordWrap="True"
                         AutomationProperties.Name="Response body" />
  </Grid>
</UserControl>
