<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RestClient.UI.ViewModels"
        x:Class="RestClient.UI.Views.SaveDestinationWindow"
        x:DataType="vm:SaveDestinationViewModel"
        Title="Save request"
        Width="420"
        Height="420"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="12" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="8">
    <TextBlock Grid.Row="0" Text="Name" />
    <TextBox Grid.Row="1" Text="{Binding Name}" />
    <TextBlock Grid.Row="2" Text="Save into" />
    <ListBox Grid.Row="3" ItemsSource="{Binding Folders}" SelectedItem="{Binding SelectedFolder}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:FolderChoice">
          <TextBlock Text="{Binding Path}" />
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Cancel" Click="OnCancelClick" />
      <Button Content="Save" IsEnabled="{Binding CanSave}" Click="OnSaveClick" />
    </StackPanel>
  </Grid>
</Window>
