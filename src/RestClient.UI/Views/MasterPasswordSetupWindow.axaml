<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RestClient.UI.ViewModels"
        x:Class="RestClient.UI.Views.MasterPasswordSetupWindow"
        x:DataType="vm:MasterPasswordSetupViewModel"
        Title="Set master password"
        Width="420"
        Height="330"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="12" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto" RowSpacing="8">
    <TextBlock Grid.Row="0"
               Text="The master password protects secret variables. It is never stored. There is no recovery: if you forget it, the secrets cannot be recovered."
               TextWrapping="Wrap" />
    <TextBlock Grid.Row="1" Text="Master password" />
    <TextBox Grid.Row="2" PasswordChar="*" Text="{Binding Password}" />
    <TextBlock Grid.Row="3" Text="Repeat the master password" />
    <TextBox Grid.Row="4" PasswordChar="*" Text="{Binding Confirmation}" />
    <TextBlock Grid.Row="5"
               Foreground="Red"
               Text="{Binding Message}"
               TextWrapping="Wrap" />
    <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Cancel" Click="OnCancelClick" />
      <Button Content="Set password" Command="{Binding CreateCommand}" />
    </StackPanel>
  </Grid>
</Window>
