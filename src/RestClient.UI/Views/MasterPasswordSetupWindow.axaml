<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RestClient.UI.ViewModels"
        xmlns:behaviors="using:RestClient.UI.Behaviors"
        x:Class="RestClient.UI.Views.MasterPasswordSetupWindow"
        x:DataType="vm:MasterPasswordSetupViewModel"
        Title="Set master password"
        Width="420"
        Height="330"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="12" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto" RowSpacing="8">
    <TextBlock Grid.Row="0"
               Text="The master password protects secret variables. It is never stored. There is no recovery: if you forget it, the secrets cannot be recovered."
               TextWrapping="Wrap" />
    <TextBlock Grid.Row="1" Text="Master password" />
    <TextBox Grid.Row="2"
             PasswordChar="*"
             Text="{Binding Password}"
             AutomationProperties.Name="Master password"
             behaviors:InitialFocus.IsTarget="True" />
    <TextBlock Grid.Row="3" Text="Repeat the master password" />
    <TextBox Grid.Row="4"
             PasswordChar="*"
             Text="{Binding Confirmation}"
             AutomationProperties.Name="Repeat the master password" />
    <TextBlock Grid.Row="5"
               Classes="error"
               Text="{Binding Message}"
               TextWrapping="Wrap"
               AutomationProperties.LiveSetting="Polite" />
    <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Set password" IsDefault="True" Command="{Binding CreateCommand}" />
      <Button Content="Cancel" IsCancel="True" Click="OnCancelClick" />
    </StackPanel>
  </Grid>
</Window>
