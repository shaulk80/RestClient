<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RestClient.UI.ViewModels"
             x:Class="RestClient.UI.Views.KeyValueEditorView"
             x:DataType="vm:KeyValueEditorViewModel">
  <StackPanel Spacing="6">
    <ItemsControl ItemsSource="{Binding Rows}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:KeyValueRowViewModel">
          <Grid ColumnDefinitions="Auto,*,*,Auto" ColumnSpacing="6" Margin="0,2">
            <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled}" />
            <TextBox Grid.Column="1" Text="{Binding Key}" PlaceholderText="Name" />
            <TextBox Grid.Column="2" Text="{Binding Value}" PlaceholderText="Value" />
            <Button Grid.Column="3" Content="Remove" Command="{Binding RemoveCommand}" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <Button HorizontalAlignment="Left" Content="Add field" Command="{Binding AddRowCommand}" />
  </StackPanel>
</UserControl>
