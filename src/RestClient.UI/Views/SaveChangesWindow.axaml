<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RestClient.UI.ViewModels"
        x:Class="RestClient.UI.Views.SaveChangesWindow"
        x:DataType="vm:SaveChangesViewModel"
        Title="Unsaved changes"
        Width="420"
        Height="180"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="12" RowDefinitions="*,Auto" RowSpacing="8">
    <TextBlock Grid.Row="0" Text="{Binding Message}" TextWrapping="Wrap" />
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Cancel" IsCancel="True" Click="OnCancelClick" />
      <Button Content="Don't save" Click="OnDiscardClick" />
      <Button Content="Save" IsDefault="True" Click="OnSaveClick" />
    </StackPanel>
  </Grid>
</Window>
