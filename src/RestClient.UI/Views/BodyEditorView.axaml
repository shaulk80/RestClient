<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RestClient.UI.ViewModels"
             xmlns:controls="using:RestClient.UI.Controls"
             xmlns:views="using:RestClient.UI.Views"
             x:Class="RestClient.UI.Views.BodyEditorView"
             x:DataType="vm:BodyEditorViewModel">
  <StackPanel Spacing="8">
    <!-- The controls that belong to the body type are to the right of it, so the body gets the height. -->
    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
      <ComboBox x:Name="BodyTypeBox"
                Grid.Column="0"
                Width="190"
                ItemsSource="{Binding Types}"
                SelectedItem="{Binding SelectedType}"
                AutomationProperties.Name="Body type">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:BodyTypeChoice">
            <TextBlock Text="{Binding Label}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <!-- Editable: pick a common type, type another one, or clear the box. -->
      <ComboBox Grid.Column="1"
                HorizontalAlignment="Stretch"
                IsVisible="{Binding IsRaw}"
                IsEditable="True"
                ItemsSource="{Binding ContentTypes}"
                Text="{Binding ContentType}"
                PlaceholderText="Content-Type, for example application/json"
                AutomationProperties.Name="Body content type" />
      <Button Grid.Column="2"
              Content="Format"
              IsVisible="{Binding IsRaw}"
              Command="{Binding FormatCommand}"
              IsEnabled="{Binding CanFormat}" />
      <Button Grid.Column="2"
              Content="{Binding Form.AddRowText}"
              IsVisible="{Binding IsFormUrlEncoded}"
              Command="{Binding Form.AddRowCommand}" />
      <Button Grid.Column="2"
              Content="Add part"
              IsVisible="{Binding IsMultipart}"
              Command="{Binding Multipart.AddRowCommand}" />
    </Grid>
    <TextBlock Name="NoBodyHint"
               Text="This request sends no body. Choose a body type to add one."
               IsVisible="{Binding IsNone}"
               FontStyle="Italic" />
    <StackPanel IsVisible="{Binding IsRaw}" Spacing="8">
      <Border Classes="panel">
        <controls:CodeEditor x:Name="BodyCodeEditor"
                             EditorText="{Binding Text}"
                             Language="{Binding Language}"
                             WordWrap="True"
                             Height="320"
                             AutomationProperties.Name="Request body" />
      </Border>
      <TextBlock Text="Highlighting is off for bodies over 1 MB."
                 IsVisible="{Binding IsLargeBody}"
                 FontStyle="Italic" />
    </StackPanel>
    <StackPanel IsVisible="{Binding IsFormUrlEncoded}">
      <views:KeyValueEditorView ShowAddButton="False" DataContext="{Binding Form}" />
    </StackPanel>
    <StackPanel IsVisible="{Binding IsMultipart}">
      <views:MultipartEditorView ShowAddButton="False" DataContext="{Binding Multipart}" />
    </StackPanel>
    <TextBlock Text="{Binding Message}"
               Classes="error"
               TextWrapping="Wrap"
               AutomationProperties.LiveSetting="Polite" />
  </StackPanel>
</UserControl>
