<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RestClient.UI.ViewModels"
        xmlns:behaviors="using:RestClient.UI.Behaviors"
        x:Class="RestClient.UI.Views.UnlockDialogWindow"
        x:DataType="vm:UnlockDialogViewModel"
        Title="Unlock secrets"
        Width="380"
        Height="200"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="12" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8">
    <TextBlock Grid.Row="0" Text="Master password" />
    <TextBox Grid.Row="1"
             PasswordChar="*"
             Text="{Binding Password}"
             PlaceholderText="Master password"
             AutomationProperties.Name="Master password"
             behaviors:InitialFocus.IsTarget="True"
             KeyDown="OnKeyDown" />
    <TextBlock Grid.Row="2"
               Classes="error"
               Text="{Binding Message}"
               TextWrapping="Wrap"
               AutomationProperties.LiveSetting="Polite" />
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Unlock" Command="{Binding UnlockCommand}" />
      <Button Content="Cancel" IsCancel="True" Click="OnCancelClick" />
    </StackPanel>
  </Grid>
</Window>
