<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:RestClient.UI.Views"
        xmlns:vm="using:RestClient.UI.ViewModels"
        x:Class="RestClient.UI.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="REST Client"
        Width="1100"
        Height="700"
        MinWidth="640"
        MinHeight="400">
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+Enter" Command="{Binding TabStrip.SendSelectedCommand}" />
    <KeyBinding Gesture="Ctrl+S" Command="{Binding TabStrip.SaveSelectedCommand}" />
    <KeyBinding Gesture="Ctrl+T" Command="{Binding TabStrip.NewTabCommand}" />
    <KeyBinding Gesture="Ctrl+F4" Command="{Binding TabStrip.CloseSelectedCommand}" />
  </Window.KeyBindings>
  <Grid ColumnDefinitions="260,*" RowDefinitions="*,Auto">
    <TabControl Grid.Column="0" Grid.Row="0">
      <TabItem Header="Collections">
        <views:CollectionsTreeView DataContext="{Binding Sidebar}" />
      </TabItem>
      <TabItem Header="History">
        <views:HistoryListView DataContext="{Binding History}" />
      </TabItem>
    </TabControl>
    <TabControl Grid.Column="1"
                Grid.Row="0"
                ItemsSource="{Binding TabStrip.Tabs}"
                SelectedItem="{Binding TabStrip.SelectedTab}">
      <TabControl.ItemTemplate>
        <DataTemplate x:DataType="vm:RequestTabViewModel">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock VerticalAlignment="Center" Text="{Binding Header}" />
            <Button Padding="4,0"
                    Content="×"
                    Command="{Binding CloseCommand}"
                    ToolTip.Tip="Close tab (Ctrl+F4)"
                    AutomationProperties.Name="Close tab" />
          </StackPanel>
        </DataTemplate>
      </TabControl.ItemTemplate>
      <TabControl.ContentTemplate>
        <DataTemplate x:DataType="vm:RequestTabViewModel">
          <Grid RowDefinitions="Auto,*">
            <views:RequestBuilderView Grid.Row="0" />
            <views:ResponseView Grid.Row="1" />
          </Grid>
        </DataTemplate>
      </TabControl.ContentTemplate>
    </TabControl>
    <TextBlock Grid.Column="1"
               Grid.Row="0"
               Margin="12"
               VerticalAlignment="Top"
               IsVisible="{Binding !TabStrip.HasTabs}"
               Text="Open a request from the Collections sidebar, or create one with New request." />
    <Grid Grid.Column="0"
          Grid.ColumnSpan="2"
          Grid.Row="1"
          Margin="8,4"
          ColumnDefinitions="*,Auto">
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
        <TextBlock Foreground="Red" Text="{Binding Sidebar.StatusMessage}" />
        <TextBlock Foreground="Red" Text="{Binding TabStrip.AutosaveError}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button Content="Settings"
                Command="{Binding SettingsCommand}"
                AutomationProperties.Name="Open settings" />
        <TextBlock VerticalAlignment="Center" Text="{Binding Secrets.Text}" />
        <Button Content="{Binding Secrets.ButtonText}" Command="{Binding Secrets.ToggleCommand}" />
        <TextBlock VerticalAlignment="Center" Text="Environment" />
        <ComboBox MinWidth="180"
                  ItemsSource="{Binding Environments.Choices}"
                  SelectedItem="{Binding Environments.SelectedChoice, Mode=OneWay}"
                  SelectionChanged="OnEnvironmentSelectionChanged">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:EnvironmentChoice">
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button Content="Manage" Command="{Binding Environments.ManageCommand}" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
