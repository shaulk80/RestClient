<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:RestClient.UI.Views"
        x:Class="RestClient.UI.MainWindow"
        Title="REST Client"
        Width="1100"
        Height="700"
        MinWidth="640"
        MinHeight="400">
  <Grid RowDefinitions="Auto,*">
    <views:RequestBuilderView Grid.Row="0" />
    <views:ResponseView Grid.Row="1" />
  </Grid>
</Window>
