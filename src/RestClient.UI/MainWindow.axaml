<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:RestClient.UI.Views"
        xmlns:vm="using:RestClient.UI.ViewModels"
        x:Class="RestClient.UI.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="REST Client"
        Width="1100"
        Height="700"
        MinWidth="640"
        MinHeight="400">
  <Grid ColumnDefinitions="260,*" RowDefinitions="*,Auto">
    <TabControl Grid.Column="0" Grid.Row="0">
      <TabItem Header="Collections">
        <views:CollectionsTreeView DataContext="{Binding Sidebar}" />
      </TabItem>
      <TabItem Header="History">
        <views:HistoryListView DataContext="{Binding History}" />
      </TabItem>
    </TabControl>
    <TabControl Grid.Column="1"
                Grid.Row="0"
                ItemsSource="{Binding Tabs}"
                SelectedItem="{Binding SelectedTab}">
      <TabControl.ItemTemplate>
        <DataTemplate x:DataType="vm:RequestTabViewModel">
          <TextBlock Text="{Binding Header}" />
        </DataTemplate>
      </TabControl.ItemTemplate>
      <TabControl.ContentTemplate>
        <DataTemplate x:DataType="vm:RequestTabViewModel">
          <Grid RowDefinitions="Auto,*">
            <views:RequestBuilderView Grid.Row="0" />
            <views:ResponseView Grid.Row="1" />
          </Grid>
        </DataTemplate>
      </TabControl.ContentTemplate>
    </TabControl>
    <TextBlock Grid.Column="1"
               Grid.Row="0"
               Margin="12"
               VerticalAlignment="Top"
               IsVisible="{Binding !HasTabs}"
               Text="Open a request from the Collections sidebar, or create one with New request." />
    <Grid Grid.Column="0"
          Grid.ColumnSpan="2"
          Grid.Row="1"
          Margin="8,4"
          ColumnDefinitions="*,Auto">
      <TextBlock Grid.Column="0"
                 Foreground="Red"
                 Text="{Binding Sidebar.StatusMessage}" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <TextBlock VerticalAlignment="Center" Text="{Binding Secrets.Text}" />
        <Button Content="{Binding Secrets.ButtonText}" Command="{Binding Secrets.ToggleCommand}" />
        <TextBlock VerticalAlignment="Center" Text="Environment" />
        <ComboBox MinWidth="180"
                  ItemsSource="{Binding Environments.Choices}"
                  SelectedItem="{Binding Environments.SelectedChoice, Mode=OneWay}"
                  SelectionChanged="OnEnvironmentSelectionChanged">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:EnvironmentChoice">
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button Content="Manage" Command="{Binding Environments.ManageCommand}" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
