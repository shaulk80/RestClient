<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:RestClient.UI.Views"
        xmlns:vm="using:RestClient.UI.ViewModels"
        x:Class="RestClient.UI.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="REST Client"
        Width="1200"
        Height="720"
        MinWidth="760"
        MinHeight="420">
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+Enter" Command="{Binding TabStrip.SendSelectedCommand}" />
    <KeyBinding Gesture="Ctrl+S" Command="{Binding TabStrip.SaveSelectedCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding TabStrip.SaveAllCommand}" />
    <KeyBinding Gesture="Ctrl+T" Command="{Binding TabStrip.NewTabCommand}" />
    <KeyBinding Gesture="Ctrl+F4" Command="{Binding TabStrip.CloseSelectedCommand}" />
  </Window.KeyBindings>
  <Window.Styles>
    <!-- The top bar and the message line are thin, so their controls are smaller than the default. -->
    <Style Selector="Border.thin Button">
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="Padding" Value="8,1" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Border.thin ComboBox">
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="Padding" Value="6,1" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Border.thin TextBlock">
      <Setter Property="FontSize" Value="12" />
    </Style>
  </Window.Styles>
  <!-- Menu on top, then the thin bar with the environment and secrets, the panels, and the message line. -->
  <DockPanel>
    <Menu DockPanel.Dock="Top" AutomationProperties.Name="Main menu">
      <MenuItem Header="_File">
        <MenuItem Header="_New request" Command="{Binding TabStrip.NewTabCommand}" InputGesture="Ctrl+T" />
        <MenuItem Header="_Save" Command="{Binding TabStrip.SaveSelectedCommand}" InputGesture="Ctrl+S" />
        <MenuItem Header="Save _all" Command="{Binding TabStrip.SaveAllCommand}" InputGesture="Ctrl+Shift+S" />
        <MenuItem Header="_Close tab" Command="{Binding TabStrip.CloseSelectedCommand}" InputGesture="Ctrl+F4" />
        <Separator />
        <MenuItem Header="Se_ttings..." Command="{Binding SettingsCommand}" />
        <Separator />
        <MenuItem Header="E_xit" Click="OnExitClick" InputGesture="Alt+F4" />
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem Header="Cu_t" Click="OnCutClick" InputGesture="Ctrl+X" />
        <MenuItem Header="_Copy" Click="OnCopyClick" InputGesture="Ctrl+C" />
        <MenuItem Header="_Paste" Click="OnPasteClick" InputGesture="Ctrl+V" />
        <MenuItem Header="Select _all" Click="OnSelectAllClick" InputGesture="Ctrl+A" />
        <Separator />
        <MenuItem Header="S_end" Command="{Binding TabStrip.SendSelectedCommand}" InputGesture="Ctrl+Enter" />
        <MenuItem Header="Cancel s_end" Command="{Binding TabStrip.SelectedTab.CancelCommand}" />
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="_Collections panel" ToggleType="CheckBox" IsChecked="{Binding Layout.IsSidebarVisible}" />
        <MenuItem Header="_Response panel" ToggleType="CheckBox" IsChecked="{Binding Layout.IsResponseVisible}" />
        <Separator />
        <MenuItem Header="_Next request tab" Command="{Binding TabStrip.NextRecentTabCommand}" InputGesture="Ctrl+Tab" />
        <MenuItem Header="_Previous request tab" Command="{Binding TabStrip.PreviousRecentTabCommand}" InputGesture="Ctrl+Shift+Tab" />
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="_About" Click="OnAboutClick" />
      </MenuItem>
    </Menu>
    <Border DockPanel.Dock="Top"
            Classes="panel thin"
            BorderThickness="0,1,0,1"
            Padding="8,2">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <TextBlock VerticalAlignment="Center" Text="{Binding Secrets.Text}" />
        <Button Content="{Binding Secrets.ButtonText}"
                Command="{Binding Secrets.ToggleCommand}"
                AutomationProperties.HelpText="Locks or unlocks the secret variables" />
        <TextBlock VerticalAlignment="Center" Text="Environment" />
        <ComboBox MinWidth="160"
                  ItemsSource="{Binding Environments.Choices}"
                  SelectedItem="{Binding Environments.SelectedChoice, Mode=OneWay}"
                  AutomationProperties.Name="Active environment"
                  SelectionChanged="OnEnvironmentSelectionChanged">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:EnvironmentChoice">
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button Content="Manage"
                Command="{Binding Environments.ManageCommand}"
                AutomationProperties.Name="Manage environments" />
      </StackPanel>
    </Border>
    <!-- Only messages live here: the status of the tree, and the failure to store the open tabs. -->
    <Border DockPanel.Dock="Bottom"
            Classes="panel thin"
            BorderThickness="0,1,0,0"
            Padding="8,2"
            MinHeight="22">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <TextBlock Classes="error"
                   Text="{Binding Sidebar.StatusMessage}"
                   AutomationProperties.LiveSetting="Polite" />
        <!-- Stored tabs are the only copy of unsaved drafts, so a failure is stated in full and in bold. -->
        <TextBlock Classes="error"
                   FontWeight="SemiBold"
                   Text="{Binding TabStrip.AutosaveError, StringFormat='Open tabs are not being saved: {0}'}"
                   IsVisible="{Binding TabStrip.AutosaveError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   AutomationProperties.LiveSetting="Assertive" />
      </StackPanel>
    </Border>
    <!-- Three panels: Collections and History, the request, and the response. The splitters change the widths of
         the outer two, and the request takes what is left. -->
    <Grid x:Name="Panels" Margin="4" ColumnDefinitions="260,Auto,*">
      <TabControl Grid.Column="0"
                  IsVisible="{Binding Layout.IsSidebarVisible}"
                  AutomationProperties.Name="Sidebar">
        <TabItem Header="Collections">
          <views:CollectionsTreeView DataContext="{Binding Sidebar}" />
        </TabItem>
        <TabItem Header="History">
          <views:HistoryListView DataContext="{Binding History}" />
        </TabItem>
      </TabControl>
      <GridSplitter x:Name="SidebarSplitter"
                    Grid.Column="1"
                    Width="6"
                    IsVisible="{Binding Layout.IsSidebarVisible}"
                    DragCompleted="OnSidebarSplitterDragCompleted"
                    AutomationProperties.Name="Resize the Collections panel" />
      <Grid Grid.Column="2" RowDefinitions="Auto,*">
        <!-- Only the headers: the selected request is shown below, so the URL bar can span the response too. -->
        <TabControl Grid.Row="0"
                    ItemsSource="{Binding TabStrip.Tabs}"
                    SelectedItem="{Binding TabStrip.SelectedTab}"
                    AutomationProperties.Name="Open requests">
          <TabControl.ItemTemplate>
            <DataTemplate x:DataType="vm:RequestTabViewModel">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock VerticalAlignment="Center" Text="{Binding Header}" />
                <Button Padding="4,0"
                        Content="×"
                        Command="{Binding CloseCommand}"
                        ToolTip.Tip="Close tab (Ctrl+F4)"
                        AutomationProperties.Name="Close tab" />
              </StackPanel>
            </DataTemplate>
          </TabControl.ItemTemplate>
          <TabControl.ContentTemplate>
            <DataTemplate x:DataType="vm:RequestTabViewModel">
              <Panel />
            </DataTemplate>
          </TabControl.ContentTemplate>
        </TabControl>
        <TextBlock Grid.Row="1"
                   Margin="12"
                   VerticalAlignment="Top"
                   IsVisible="{Binding !TabStrip.HasTabs}"
                   Text="Open a request from the Collections sidebar, or create one with New request." />
        <Grid Grid.Row="1" RowDefinitions="Auto,*" IsVisible="{Binding TabStrip.HasTabs}">
          <views:RequestBarView Grid.Row="0"
                                Margin="0,8,0,4"
                                DataContext="{Binding TabStrip.SelectedTab}" />
          <Grid x:Name="RequestPanels" Grid.Row="1" ColumnDefinitions="*,Auto,420">
            <views:RequestDetailsView x:Name="Details"
                                      Grid.Column="0"
                                      DataContext="{Binding TabStrip.SelectedTab}" />
            <GridSplitter x:Name="ResponseSplitter"
                          Grid.Column="1"
                          Width="6"
                          IsVisible="{Binding Layout.IsResponseVisible}"
                          DragCompleted="OnResponseSplitterDragCompleted"
                          AutomationProperties.Name="Resize the Response panel" />
            <Border Grid.Column="2"
                    Classes="panel"
                    IsVisible="{Binding Layout.IsResponseVisible}">
              <views:ResponseView DataContext="{Binding TabStrip.SelectedTab}" />
            </Border>
          </Grid>
        </Grid>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
